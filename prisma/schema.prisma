// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
  // output   = "../amplify/layers/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Customer model for painting service users
model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String    // Hashed password
  name          String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

// Partner model for painting service providers
model Partner {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String    // Hashed password
  companyName   String
  businessPhone String
  address       String
  images        String?   // Comma-separated image URLs
  specialties   String[]  // Array of specialties
  servicePlans  Json?     // JSON array of service plans
  description   String?   // Company description
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

// Booking model for service appointments
model Booking {
  id            String    @id @default(uuid())
  date          DateTime
  servicePlan   String    // Service plan type: "basic", "standard", "premium", etc.
  status        String    // Booking status: "pending", "confirmed", "completed", "cancelled"
  notes         String?   // Additional booking information
  price         Float     // Service price
  rating        Int?      // Customer rating (1-5)
  customerId    String
  partnerId     String
  customer      Customer  @relation(fields: [customerId], references: [id])
  partner       Partner   @relation(fields: [partnerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([partnerId])
}